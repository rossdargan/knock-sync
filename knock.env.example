# Copy to knock.env and fill in. Never commit knock.env.

# --- Cloudflare knock Worker ---
KNOCK_URL=https://knock.dargan.uk
KNOCK_SYNC_TOKEN=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Resolve KNOCK_URL's host via DNS-over-HTTPS (1.1.1.1) to bypass local DNS overrides.
KNOCK_DOH=true

# --- UniFi Network Integration API ---
UNIFI_HOST=https://192.168.86.1
UNIFI_API_KEY=
UNIFI_SITE_ID=
UNIFI_LIST_V4_ID=
# Optional IPv6 list
UNIFI_LIST_V6_ID=
UNIFI_VERIFY_TLS=false

# --- Static allowlist (always included) ---
# Comma-separated IPs/CIDRs and hostnames (e.g. relatives' DDNS). You can also/instead
# put them in ./config/static.txt (see static.txt.example).
STATIC_IPS=
STATIC_HOSTS=

# --- Timing (seconds) ---
# Worker poll interval (min 5). 15s = 5,760 req/day; Workers free tier allows 100,000/day.
SYNC_INTERVAL=15
# Re-read the UniFi lists even if nothing changed, to undo manual edits/drift.
RECONCILE_INTERVAL=300
# How often STATIC_HOSTS / hostnames in static.txt are re-resolved.
STATIC_REFRESH=300
# Cap for exponential backoff after failures.
MAX_BACKOFF=300

LOG_LEVEL=INFO
